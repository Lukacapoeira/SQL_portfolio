#1 What is the total amount each customer spent at the restaurant?
select 
s.customer_id
,sum(m.price) as total_spend
from sales s 
left join menu m on m.product_id = s.product_id 
group by 1
order by 2 desc 

			customer_id|total_spend|
			-----------+-----------+
			A          |         76|
			B          |         74|
			C          |         36|

;

