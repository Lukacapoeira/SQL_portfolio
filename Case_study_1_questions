#4 What is the most purchased item on the menu and how many times was it purchased by all customers?
select 
counted.product_id 
,counted.count_of_order 
,m.product_name 
from 
	(select 
	s.product_id
	,count(s.product_id) as count_of_order
	from sales s 
	group by 1) as counted
left join menu m on counted.product_id =m.product_id
order by 2 desc
limit 1

product_id|count_of_order|product_name|
----------+--------------+------------+
         3|             8|ramen       |

;

#5 Which item was the most popular for each customer?
select * from (select 
c.customer_id 
,c.count_of_order 
,m.product_name 
,dense_rank() over (partition by c.customer_id order by c.count_of_order desc) as best_seller
from 
	(select 
	s.customer_id 
	,s.product_id 
	,count(s.product_id) as count_of_order
	from sales s 
	group by 1,2) as c
left join menu m on c.product_id = m.product_id ) counted_order
where counted_order.best_seller = 1

